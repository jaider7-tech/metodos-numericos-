"""Nucleo de calculo: independiente de la interfaz."""

"""
Traduce lo que el usuario escribe en texto a objetos matematicos usables.

Aqui esta la razon por la que la aplicacion acepta CUALQUIER ejercicio:
en vez de tener la funcion escrita a mano dentro del codigo, se interpreta
lo que el usuario teclea usando SymPy.  Ademas SymPy sabe derivar, asi que
Newton-Raphson no necesita que nadie escriba f'(x).
"""

import re

import numpy as np
import sympy as sp
from sympy.parsing.sympy_parser import (
    convert_xor,
    implicit_multiplication_application,
    parse_expr,
    standard_transformations,
)

X = sp.Symbol("x")

# convert_xor  ->  permite escribir  x^2  en vez de  x**2
# implicit_... ->  permite escribir  2x   en vez de  2*x   y   sin x
_TRANSFORMACIONES = standard_transformations + (
    implicit_multiplication_application,
    convert_xor,
)

_IDENTIFICADOR = re.compile(r"[A-Za-z_][A-Za-z_0-9]*")

# Nombres que son funciones, no incognitas.
_RESERVADAS = {
    "sin", "cos", "tan", "asin", "acos", "atan", "sinh", "cosh", "tanh",
    "exp", "log", "ln", "sqrt", "abs", "pi", "E", "e",
}


class ErrorDeEntrada(Exception):
    """Se lanza cuando el usuario escribio algo que no se puede interpretar."""


def _parsear(texto):
    texto = (texto or "").strip()
    if not texto:
        raise ErrorDeEntrada("El campo esta vacio.")
    try:
        return parse_expr(texto, transformations=_TRANSFORMACIONES)
    except Exception as error:
        raise ErrorDeEntrada(f"No pude interpretar «{texto}». Detalle: {error}")


# ---------------------------------------------------------------- funciones

def funcion(texto, variable=X):
    """Devuelve (f_numerica, expresion_simbolica) a partir de un texto."""
    expresion = _parsear(texto)
    sobrantes = expresion.free_symbols - {variable}
    if sobrantes:
        nombres = ", ".join(sorted(str(s) for s in sobrantes))
        raise ErrorDeEntrada(
            f"La expresion usa la(s) variable(s) «{nombres}». "
            f"Solo se admite «{variable}»."
        )
    return sp.lambdify(variable, expresion, "numpy"), expresion


def derivada(expresion, variable=X):
    """Deriva simbolicamente y devuelve (f'_numerica, expresion_derivada)."""
    d = sp.diff(expresion, variable)
    return sp.lambdify(variable, d, "numpy"), d


def evaluar(f, xs):
    """Evalua f sobre un arreglo tolerando dominios invalidos (log, sqrt...)."""
    salida = np.full(len(xs), np.nan, dtype=float)
    for i, xi in enumerate(xs):
        try:
            valor = float(f(xi))
            if np.isfinite(valor):
                salida[i] = valor
        except Exception:
            pass
    return salida


def bonito(expresion):
    """Version LaTeX para mostrar la expresion en pantalla."""
    return sp.latex(expresion)


# ------------------------------------------------------- sistemas lineales

def _incognitas_en_orden(texto, simbolos):
    """Ordena las incognitas segun su primera aparicion en el texto."""
    vistos, orden = set(), []
    nombres = {str(s): s for s in simbolos}
    for nombre in _IDENTIFICADOR.findall(texto):
        if nombre in nombres and nombre not in vistos:
            vistos.add(nombre)
            orden.append(nombres[nombre])
    # por si alguna incognita solo aparece en una forma rara
    for s in simbolos:
        if s not in orden:
            orden.append(s)
    return orden


def sistema_desde_texto(texto):
    """
    Convierte un sistema escrito en lenguaje natural a matrices (A, b).

    Ejemplo de entrada:
        2x + y + z = 3
        4x + 3y + 2z = 6
        -2x + 5y + 4z = 7

    Devuelve (A, b, nombres_de_incognitas).
    """
    lineas = [l.strip() for l in (texto or "").splitlines() if l.strip()]
    if not lineas:
        raise ErrorDeEntrada("No escribiste ninguna ecuacion.")

    ecuaciones, simbolos = [], set()
    for numero, linea in enumerate(lineas, start=1):
        if linea.count("=") != 1:
            raise ErrorDeEntrada(
                f"La ecuacion {numero} debe tener exactamente un signo «=»: {linea}"
            )
        izquierda, derecha = linea.split("=")
        ecuacion = sp.Eq(_parsear(izquierda), _parsear(derecha))
        ecuaciones.append(ecuacion)
        simbolos |= ecuacion.free_symbols

    simbolos = {s for s in simbolos if str(s) not in _RESERVADAS}
    incognitas = _incognitas_en_orden(texto, simbolos)

    if len(ecuaciones) != len(incognitas):
        raise ErrorDeEntrada(
            f"Hay {len(ecuaciones)} ecuacion(es) y {len(incognitas)} incognita(s). "
            "El sistema debe ser cuadrado."
        )

    try:
        A, b = sp.linear_eq_to_matrix(ecuaciones, incognitas)
    except Exception:
        raise ErrorDeEntrada(
            "El sistema no es lineal (hay productos entre incognitas, potencias, etc.)."
        )

    A = np.array(A.tolist(), dtype=float)
    b = np.array(b.tolist(), dtype=float).flatten()
    return A, b, [str(s) for s in incognitas]


def sistema_a_texto(A, b, nombres):
    """Reconstruye las ecuaciones en texto (util para mostrar el sistema)."""
    lineas = []
    for fila, termino in zip(A, b):
        partes = []
        for coeficiente, nombre in zip(fila, nombres):
            if abs(coeficiente) < 1e-14:
                continue
            signo = "-" if coeficiente < 0 else ("+" if partes else "")
            magnitud = abs(coeficiente)
            texto = "" if abs(magnitud - 1) < 1e-14 else f"{magnitud:g}"
            partes.append(f"{signo} {texto}{nombre}".strip())
        lineas.append(f"{' '.join(partes) or '0'} = {termino:g}")
    return "\n".join(lineas)

"""
Metodos para encontrar raices de f(x) = 0.

IDEA CENTRAL DE LA OPTIMIZACION
-------------------------------
Biseccion, punto fijo, regula falsi, Newton-Raphson y la secante parecen
cinco algoritmos distintos, pero todos hacen exactamente lo mismo:

    1. parten de un estado inicial
    2. aplican una regla para obtener una nueva aproximacion
    3. miden el error
    4. repiten hasta que el error sea menor que la tolerancia

Lo unico que cambia entre ellos es el paso 2.  Por eso aqui hay UN SOLO
motor de iteracion (`_ejecutar`) y cada metodo aporta unicamente su regla,
que ocupa entre cuatro y ocho lineas.
"""

from dataclasses import dataclass, field

import numpy as np
import pandas as pd

CERO = 1e-14
DESBORDE = 1e14


class ErrorDeMetodo(Exception):
    """El metodo no se puede aplicar con los datos entregados."""


@dataclass
class Resultado:
    raiz: float | None = None
    tabla: pd.DataFrame = field(default_factory=pd.DataFrame)
    convergio: bool = False
    mensaje: str = ""
    iteraciones: int = 0
    historial: list = field(default_factory=list)   # aproximaciones sucesivas


# --------------------------------------------------------------- el motor

def _ejecutar(paso, estado, tol, max_iter):
    """
    Motor de iteracion compartido por los cinco metodos.

    `paso` recibe el estado actual y devuelve:
        (nueva_aproximacion, nuevo_estado, fila_de_la_tabla)
    donde la fila incluye la columna "Error".
    """
    filas, historial = [], []
    raiz, convergio, mensaje = None, False, ""

    for k in range(1, int(max_iter) + 1):
        try:
            raiz, estado, fila = paso(estado)
        except ZeroDivisionError:
            mensaje = f"Division por cero en la iteracion {k}: el metodo se detiene."
            break
        except ErrorDeMetodo as error:
            mensaje = f"Iteracion {k}: {error}"
            break

        if not np.isfinite(raiz) or abs(raiz) > DESBORDE:
            mensaje = f"El metodo diverge (iteracion {k}). Prueba otro valor inicial."
            raiz = None
            break

        filas.append({"Iter": k, **fila})
        historial.append(raiz)

        if fila["Error"] <= tol:
            convergio = True
            mensaje = f"Converge en {k} iteraciones con error {fila['Error']:.2e}."
            break
    else:
        mensaje = (
            f"Se alcanzo el maximo de {int(max_iter)} iteraciones sin llegar "
            f"a la tolerancia pedida."
        )

    return Resultado(
        raiz=raiz,
        tabla=pd.DataFrame(filas),
        convergio=convergio,
        mensaje=mensaje,
        iteraciones=len(filas),
        historial=historial,
    )


# ------------------------------------------------------------- los metodos

def biseccion(f, a, b, tol=1e-6, max_iter=100):
    """Parte el intervalo por la mitad conservando el cambio de signo."""
    fa, fb = f(a), f(b)
    if not np.isfinite(fa) or not np.isfinite(fb):
        raise ErrorDeMetodo("La funcion no esta definida en algun extremo del intervalo.")
    if fa * fb > 0:
        raise ErrorDeMetodo(
            f"No hay cambio de signo: f({a:g}) = {fa:g} y f({b:g}) = {fb:g} "
            "tienen el mismo signo. Elige otro intervalo."
        )

    def paso(estado):
        a, b = estado
        c = (a + b) / 2
        fa, fc = f(a), f(c)
        fila = {
            "a": a, "b": b, "c = (a+b)/2": c,
            "f(a)": fa, "f(c)": fc, "Error": (b - a) / 2,
        }
        nuevo = (a, c) if fa * fc < 0 else (c, b)
        return c, nuevo, fila

    return _ejecutar(paso, (a, b), tol, max_iter)


def regula_falsi(f, a, b, tol=1e-6, max_iter=100):
    """Como la biseccion, pero corta con la recta que une (a,f(a)) y (b,f(b))."""
    fa, fb = f(a), f(b)
    if fa * fb > 0:
        raise ErrorDeMetodo(
            f"No hay cambio de signo: f({a:g}) = {fa:g} y f({b:g}) = {fb:g}. "
            "Elige otro intervalo."
        )

    def paso(estado):
        a, b, anterior = estado
        fa, fb = f(a), f(b)
        if abs(fb - fa) < CERO:
            raise ErrorDeMetodo("f(a) y f(b) son practicamente iguales.")
        c = (a * fb - b * fa) / (fb - fa)
        fc = f(c)
        error = abs(c - anterior) if anterior is not None else abs(b - a)
        fila = {"a": a, "b": b, "c": c, "f(a)": fa, "f(c)": fc, "Error": error}
        nuevo = (a, c, c) if fa * fc < 0 else (c, b, c)
        return c, nuevo, fila

    return _ejecutar(paso, (a, b, None), tol, max_iter)


def punto_fijo(g, x0, tol=1e-6, max_iter=100):
    """Itera x = g(x) hasta que el valor deje de moverse."""

    def paso(x):
        siguiente = g(x)
        fila = {"x_k": x, "g(x_k)": siguiente, "Error": abs(siguiente - x)}
        return siguiente, siguiente, fila

    return _ejecutar(paso, x0, tol, max_iter)


def newton_raphson(f, df, x0, tol=1e-6, max_iter=100):
    """Avanza por la recta tangente. La derivada la calcula SymPy sola."""

    def paso(x):
        fx, dfx = f(x), df(x)
        if abs(dfx) < CERO:
            raise ErrorDeMetodo(
                f"La derivada vale casi cero en x = {x:g}: la tangente es horizontal."
            )
        siguiente = x - fx / dfx
        fila = {
            "x_k": x, "f(x_k)": fx, "f'(x_k)": dfx,
            "x_(k+1)": siguiente, "Error": abs(siguiente - x),
        }
        return siguiente, siguiente, fila

    return _ejecutar(paso, x0, tol, max_iter)


def secante(f, x0, x1, tol=1e-6, max_iter=100):
    """Newton sin derivada: usa una recta por los dos ultimos puntos."""

    def paso(estado):
        x0, x1 = estado
        f0, f1 = f(x0), f(x1)
        if abs(f1 - f0) < CERO:
            raise ErrorDeMetodo("f(x0) y f(x1) son practicamente iguales.")
        siguiente = x1 - f1 * (x1 - x0) / (f1 - f0)
        fila = {
            "x_(k-1)": x0, "x_k": x1, "f(x_(k-1))": f0, "f(x_k)": f1,
            "x_(k+1)": siguiente, "Error": abs(siguiente - x1),
        }
        return siguiente, (x1, siguiente), fila

    return _ejecutar(paso, (x0, x1), tol, max_iter)

"""
Metodos para resolver sistemas de ecuaciones lineales A x = b.

SEGUNDA IDEA DE LA OPTIMIZACION
-------------------------------
Gauss-Seidel y Gauss-Jacobi se escriben normalmente como dos algoritmos
separados, pero la diferencia entre ellos cabe en una sola linea: Jacobi
usa los valores de la iteracion anterior durante todo el barrido, Seidel
usa los que acaba de calcular.  Aqui hay una unica funcion `_iterativo`
con un interruptor booleano, y dos envoltorios de dos lineas cada uno.
"""

from dataclasses import dataclass, field
from itertools import permutations

import numpy as np
import pandas as pd

CERO = 1e-12


class ErrorDeMetodo(Exception):
    """El sistema no se puede resolver con el metodo elegido."""


@dataclass
class Resultado:
    solucion: np.ndarray | None = None
    tabla: pd.DataFrame = field(default_factory=pd.DataFrame)
    convergio: bool = True
    mensaje: str = ""
    pasos: list = field(default_factory=list)      # [(titulo, matriz), ...]
    avisos: list = field(default_factory=list)
    historial: list = field(default_factory=list)  # error por iteracion


def _validar(A, b):
    A = np.array(A, dtype=float)
    b = np.array(b, dtype=float).flatten()
    if A.ndim != 2 or A.shape[0] != A.shape[1]:
        raise ErrorDeMetodo("La matriz de coeficientes debe ser cuadrada.")
    if A.shape[0] != b.size:
        raise ErrorDeMetodo("El numero de ecuaciones no coincide con el de terminos independientes.")
    return A, b


def residuo(A, b, x):
    """Norma del residuo ||Ax - b||: sirve para verificar cualquier solucion."""
    return float(np.linalg.norm(A @ x - b, np.inf))


# ------------------------------------------------------------ Gauss-Jordan

def gauss_jordan(A, b):
    """
    Reduce la matriz aumentada hasta la identidad, con pivoteo parcial.
    Guarda cada matriz intermedia para poder mostrar el procedimiento.
    """
    A, b = _validar(A, b)
    n = len(b)
    M = np.hstack([A, b.reshape(-1, 1)])
    pasos = [("Matriz aumentada inicial", M.copy())]
    avisos = []

    for i in range(n):
        # pivoteo parcial: se sube la fila con el mayor coeficiente
        fila_pivote = i + int(np.argmax(np.abs(M[i:, i])))
        if abs(M[fila_pivote, i]) < CERO:
            raise ErrorDeMetodo(
                f"La columna {i + 1} no tiene pivote valido: el sistema no tiene "
                "solucion unica (es singular o tiene infinitas soluciones)."
            )
        if fila_pivote != i:
            M[[i, fila_pivote]] = M[[fila_pivote, i]]
            avisos.append(f"Se intercambiaron las filas {i + 1} y {fila_pivote + 1} (pivoteo parcial).")
            pasos.append((f"Intercambio F{i + 1} <-> F{fila_pivote + 1}", M.copy()))

        pivote = M[i, i]
        M[i] = M[i] / pivote
        pasos.append((f"F{i + 1} -> F{i + 1} / {pivote:.6g}", M.copy()))

        for j in range(n):
            if j != i and abs(M[j, i]) > CERO:
                factor = M[j, i]
                M[j] = M[j] - factor * M[i]
                pasos.append((f"F{j + 1} -> F{j + 1} - ({factor:.6g}) F{i + 1}", M.copy()))

    solucion = M[:, -1]
    return Resultado(
        solucion=solucion,
        pasos=pasos,
        avisos=avisos,
        mensaje=f"Solucion exacta obtenida en {len(pasos) - 1} operaciones elementales. "
                f"Residuo ||Ax-b|| = {residuo(A, b, solucion):.2e}",
    )


# ------------------------------------------- Gauss-Seidel y Gauss-Jacobi

def radio_espectral(A, usar_actualizados):
    """
    Radio espectral de la matriz de iteracion.  Es EL criterio de convergencia:
    el metodo converge (desde cualquier punto inicial) si y solo si rho < 1.

        Jacobi        T = -D^-1 (L + U)
        Gauss-Seidel  T = -(D + L)^-1 U
    """
    D = np.diag(np.diag(A))
    L = np.tril(A, -1)
    U = np.triu(A, 1)
    try:
        T = -np.linalg.inv(D + L) @ U if usar_actualizados else -np.linalg.inv(D) @ (L + U)
        return float(np.max(np.abs(np.linalg.eigvals(T))))
    except np.linalg.LinAlgError:
        return np.inf


def es_dominante(A):
    n = A.shape[0]
    return all(abs(A[i, i]) >= np.sum(np.abs(A[i])) - abs(A[i, i]) - CERO for i in range(n))


def _orden_voraz(A):
    """Para sistemas grandes: asigna a cada columna la fila de mayor coeficiente."""
    n = A.shape[0]
    M = np.abs(A.copy())
    orden = [None] * n
    for _ in range(n):
        i, j = np.unravel_index(np.argmax(M), M.shape)
        orden[j] = int(i)
        M[i, :] = -1
        M[:, j] = -1
    return orden


def _mejor_orden(A, usar_actualizados):
    """
    Elige la permutacion de ecuaciones que mejor sirve al metodo iterativo.

    En el cuaderno original este reordenamiento estaba hecho a mano y sin
    explicarlo (las ecuaciones estaban emparejadas con formulas de otras
    filas).  Aqui el programa lo hace solo, y ademas justifica la eleccion
    con el radio espectral.
    """
    n = A.shape[0]
    candidatas = list(permutations(range(n))) if n <= 6 else [
        tuple(range(n)), tuple(_orden_voraz(A))
    ]

    mejor, mejor_puntaje = None, None
    for P in candidatas:
        M = A[list(P)]
        if np.min(np.abs(np.diag(M))) < CERO:
            continue                       # cero en la diagonal: inservible
        puntaje = (0 if es_dominante(M) else 1, radio_espectral(M, usar_actualizados))
        if mejor_puntaje is None or puntaje < mejor_puntaje:
            mejor, mejor_puntaje = list(P), puntaje

    if mejor is None:
        raise ErrorDeMetodo(
            "No existe forma de reordenar las ecuaciones para evitar un cero en "
            "la diagonal. Los metodos iterativos no se pueden aplicar a este sistema."
        )
    return mejor, mejor != list(range(n)), mejor_puntaje[0] == 0, mejor_puntaje[1]


def _iterativo(A, b, x0=None, tol=1e-6, max_iter=100, usar_actualizados=False):
    """Motor comun. usar_actualizados=False -> Jacobi ; True -> Gauss-Seidel."""
    A, b = _validar(A, b)
    n = len(b)

    orden, se_reordeno, dominante, rho = _mejor_orden(A, usar_actualizados)
    A, b = A[orden], b[orden]

    avisos = []
    if se_reordeno:
        avisos.append(
            "Se reordenaron las ecuaciones como "
            + " , ".join(f"E{i + 1}" for i in orden)
            + " para que el metodo pueda converger. El sistema es el mismo: "
            "solo cambia el orden en que se escriben las ecuaciones."
        )
    if dominante:
        avisos.append("La matriz es diagonalmente dominante: la convergencia esta garantizada.")
    avisos.append(
        f"Radio espectral de la matriz de iteracion: rho = {rho:.4f}. "
        + ("Como rho < 1, el metodo converge." if rho < 1 else
           "Como rho >= 1, el metodo NO converge con ningun valor inicial.")
    )

    nombres = [f"x{i + 1}" for i in range(n)]
    x = np.zeros(n) if x0 is None else np.array(x0, dtype=float).flatten()
    filas, historial = [], []
    convergio, mensaje = False, ""

    for k in range(1, int(max_iter) + 1):
        anterior = x.copy()
        nuevo = anterior.copy()

        for i in range(n):
            base = nuevo if usar_actualizados else anterior
            suma = A[i] @ base - A[i, i] * base[i]
            nuevo[i] = (b[i] - suma) / A[i, i]

        if not np.all(np.isfinite(nuevo)) or np.max(np.abs(nuevo)) > 1e14:
            mensaje = f"El metodo diverge en la iteracion {k}."
            break

        error = float(np.max(np.abs(nuevo - anterior)))
        porcentual = float(
            np.max(np.abs((nuevo - anterior) / np.where(np.abs(nuevo) < CERO, 1, nuevo))) * 100
        )
        filas.append(
            {"Iter": k, **dict(zip(nombres, nuevo)), "Error abs.": error, "Error %": porcentual}
        )
        historial.append(error)
        x = nuevo

        if error <= tol:
            convergio = True
            mensaje = f"Converge en {k} iteraciones con error {error:.2e}."
            break
    else:
        mensaje = f"Se alcanzo el maximo de {int(max_iter)} iteraciones sin cumplir la tolerancia."

    if convergio:
        mensaje += f" Residuo ||Ax-b|| = {residuo(A, b, x):.2e}"

    return Resultado(
        solucion=x,
        tabla=pd.DataFrame(filas),
        convergio=convergio,
        mensaje=mensaje,
        avisos=avisos,
        historial=historial,
    )


def gauss_jacobi(A, b, x0=None, tol=1e-6, max_iter=100):
    """Todas las incognitas se actualizan con los valores de la iteracion previa."""
    return _iterativo(A, b, x0, tol, max_iter, usar_actualizados=False)


def gauss_seidel(A, b, x0=None, tol=1e-6, max_iter=100):
    """Cada incognita usa de inmediato los valores recien calculados."""
    return _iterativo(A, b, x0, tol, max_iter, usar_actualizados=True)


# ------------------------------------------------------- Algoritmo de Thomas

def diagonales(A):
    """Extrae (subdiagonal, diagonal, superdiagonal) y verifica que sea tridiagonal."""
    A = np.array(A, dtype=float)
    n = A.shape[0]
    fuera = [
        (i + 1, j + 1)
        for i in range(n)
        for j in range(n)
        if abs(i - j) > 1 and abs(A[i, j]) > CERO
    ]
    if fuera:
        posiciones = ", ".join(f"({i},{j})" for i, j in fuera[:5])
        raise ErrorDeMetodo(
            "La matriz no es tridiagonal: hay coeficientes distintos de cero en "
            f"{posiciones}. El algoritmo de Thomas solo aplica a matrices tridiagonales."
        )
    inferior = np.array([A[i, i - 1] for i in range(1, n)])
    principal = np.array([A[i, i] for i in range(n)])
    superior = np.array([A[i, i + 1] for i in range(n - 1)])
    return inferior, principal, superior


def thomas(A, b):
    """
    Barrido hacia adelante y sustitucion hacia atras para matrices tridiagonales.
    Cuesta O(n) en lugar de O(n^3): esa es toda su gracia.
    """
    A, b = _validar(A, b)
    inferior, principal, superior = diagonales(A)
    n = len(b)

    c = np.zeros(n)   # superdiagonal modificada
    d = np.zeros(n)   # termino independiente modificado

    if abs(principal[0]) < CERO:
        raise ErrorDeMetodo("El primer elemento de la diagonal es cero: no se puede iniciar el barrido.")
    c[0] = (superior[0] / principal[0]) if n > 1 else 0.0
    d[0] = b[0] / principal[0]

    for i in range(1, n):
        denominador = principal[i] - inferior[i - 1] * c[i - 1]
        if abs(denominador) < CERO:
            raise ErrorDeMetodo(f"Denominador nulo en la fila {i + 1}: el sistema es singular.")
        c[i] = (superior[i] / denominador) if i < n - 1 else 0.0
        d[i] = (b[i] - inferior[i - 1] * d[i - 1]) / denominador

    x = np.zeros(n)
    x[-1] = d[-1]
    for i in range(n - 2, -1, -1):
        x[i] = d[i] - c[i] * x[i + 1]

    tabla = pd.DataFrame({
        "Fila": range(1, n + 1),
        "a (inferior)": np.concatenate([[np.nan], inferior]),
        "b (diagonal)": principal,
        "c (superior)": np.concatenate([superior, [np.nan]]),
        "d (indep.)": b,
        "c' modificada": c,
        "d' modificada": d,
        "Solucion": x,
    })

    return Resultado(
        solucion=x,
        tabla=tabla,
        mensaje=f"Resuelto en un solo barrido (O(n) operaciones). "
                f"Residuo ||Ax-b|| = {residuo(A, b, x):.2e}",
    )

